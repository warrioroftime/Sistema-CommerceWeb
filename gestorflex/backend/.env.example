# ============================================================
# GestorFlex — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados
# ============================================================

# Servidor
PORT=3001
NODE_ENV=development

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GestorFlex
DB_USER=sa
DB_PASSWORD=SuaSenhaAqui
DB_ENCRYPT=false
DB_TRUST_CERT=true

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# CORS — domínio do frontend (em prod, coloque o domínio real)
CORS_ORIGIN=http://localhost:5500
